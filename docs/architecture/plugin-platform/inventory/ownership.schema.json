{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mossx.dev/schemas/plugin-ownership-inventory.json",
  "title": "Mossx plugin ownership inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedFrom", "owners"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "generatedFrom": { "type": "string" },
    "notes": { "type": "string" },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layer", "path", "ownerClass", "deleteGate"],
        "properties": {
          "id": { "type": "string" },
          "layer": { "enum": ["frontend", "rust", "shared"] },
          "path": { "type": "string" },
          "ownerClass": {
            "enum": ["core", "pilot", "later-plugin", "retired-unreferenced"]
          },
          "targetPluginId": { "type": ["string", "null"] },
          "commands": { "type": "array", "items": { "type": "string" } },
          "stores": { "type": "array", "items": { "type": "string" } },
          "dataPaths": { "type": "array", "items": { "type": "string" } },
          "deleteGate": {
            "enum": ["never", "after-pilot-disable", "when-unreferenced"]
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
