{
  "pluginId": "com.mossx.notes",
  "wave": "4A",
  "status": "inventory-only",
  "deleteGate": "after-pilot-disable",
  "surfaces": {
    "backend": [
      "src-tauri/src/note_cards.rs"
    ],
    "commands": [
      "note_card_list",
      "note_card_get",
      "note_card_create",
      "note_card_update",
      "note_card_archive",
      "note_card_restore",
      "note_card_delete"
    ],
    "frontend": [
      "src/features/note-cards/components/WorkspaceNoteCardPanel.tsx",
      "src/features/note-cards/components/WorkspaceNoteCardsLayoutContext.tsx",
      "src/features/note-cards/services/noteCardsFacade.ts",
      "src/features/note-cards/utils/noteCapture.ts",
      "src/features/note-cards/utils/noteCardContextInjection.ts",
      "src/services/tauri/noteCards.ts",
      "src/styles/note-cards.css"
    ],
    "conversationCapture": [
      "src/features/messages/hooks/useConversationNoteCaptureMenu.ts",
      "src/features/messages/utils/context/messagesNoteCardContext.ts",
      "src/features/messages/components/context/NoteCardContextSummaryCard.tsx"
    ],
    "i18n": ["src/i18n/locales/*/noteCards.ts"]
  },
  "stayInCore": [
    "src-tauri/src/app_paths.rs",
    "src-tauri/src/client_storage.rs",
    "src-tauri/src/command_registry.rs",
    "src/app-shell/assembly/AppShell.tsx",
    "src/features/workspaces"
  ],
  "mustNotMoveWithNotes": [
    "src/features/update/components/ReleaseNotesModal.tsx",
    "src/features/update/hooks/useReleaseNotes.ts",
    "src/styles/release-notes.css",
    "src-tauri/src/engine/claude*",
    "src-tauri/src/plugin_runtime/*"
  ],
  "storageNote": "note_cards.rs uses app_paths and workspace-local files. 4A does not migrate tables or write plugin-runtime/data. Wave 2 DiskStorage stays unused by Notes.",
  "notes": "4A inventory only. Do not dual-write, do not disable Claude, do not copy note_cards into plugin_runtime."
}
