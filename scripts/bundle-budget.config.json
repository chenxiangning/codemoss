{
  "schemaVersion": "1.0",
  "groups": [
    {
      "id": "app-js",
      "label": "Router/App lazy entry (NOT full shell; see app-shell-js)",
      "patterns": ["App-*.js"],
      "unit": "bytes-gzip",
      "target": 950000,
      "hardFail": 1100000,
      "mode": "advisory"
    },
    {
      "id": "app-shell-js",
      "label": "AppShell main-window chunk (post-lazy real shell cost)",
      "patterns": ["app-shell-*.js"],
      "unit": "bytes-gzip",
      "target": 1100000,
      "hardFail": 1400000,
      "mode": "advisory"
    },
    {
      "id": "app-css",
      "label": "Startup app CSS",
      "patterns": ["App-*.css"],
      "unit": "bytes-gzip",
      "target": 180000,
      "hardFail": 220000,
      "mode": "advisory"
    },
    {
      "id": "startup-critical",
      "label": "Cold-start critical path (bootstrap + App entry + shell + react + startup CSS)",
      "patterns": [
        "bootstrapApp-*.js",
        "App-*.js",
        "app-shell-*.js",
        "vendor-react-*.js",
        "App-*.css",
        "app-shell-*.css"
      ],
      "unit": "bytes-gzip",
      "target": 1600000,
      "hardFail": 2000000,
      "mode": "advisory"
    },
    {
      "id": "total-js-mjs-css",
      "label": "Total JS/MJS/CSS payload",
      "patterns": ["*.js", "*.mjs", "*.css"],
      "unit": "bytes-gzip",
      "target": 4800000,
      "hardFail": 5300000,
      "mode": "advisory"
    },
    {
      "id": "vendor-mermaid",
      "label": "Mermaid optional vendor",
      "patterns": ["vendor-mermaid-*.js"],
      "unit": "bytes-gzip",
      "target": null,
      "hardFail": null,
      "mode": "advisory",
      "startupEagerness": "lazy-required"
    },
    {
      "id": "vendor-codemirror",
      "label": "CodeMirror optional vendor",
      "patterns": ["vendor-codemirror-*.js"],
      "unit": "bytes-gzip",
      "target": null,
      "hardFail": null,
      "mode": "advisory",
      "startupEagerness": "lazy-required"
    },
    {
      "id": "vendor-docs",
      "label": "Document preview optional vendor",
      "patterns": ["vendor-docs-*.js"],
      "unit": "bytes-gzip",
      "target": null,
      "hardFail": null,
      "mode": "advisory",
      "startupEagerness": "lazy-required"
    }
  ]
}
