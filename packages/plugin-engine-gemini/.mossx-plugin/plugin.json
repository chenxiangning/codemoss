{
  "manifestVersion": 1,
  "pluginId": "com.mossx.engine.gemini",
  "version": "1.0.0",
  "displayName": "Gemini Engine",
  "description": "Transitional Gemini Engine package. In-repo layering only. Not installed by boot.",
  "publisher": {
    "id": "com.mossx",
    "displayName": "Mossx",
    "homepage": "https://mossx.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mossx/mossx-plugin-engine-gemini",
    "commit": "0000000000000000000000000000000000000000"
  },
  "license": "MIT",
  "channel": "stable",
  "compatibility": {
    "coreApi": ">=1.0.0 <2.0.0",
    "platforms": [
      "darwin-arm64",
      "darwin-x64",
      "windows-x64",
      "windows-arm64",
      "linux-x64",
      "linux-arm64"
    ]
  },
  "entries": [
    {
      "id": "gemini-cli",
      "kind": "process",
      "criticality": "required",
      "platforms": {
        "darwin-arm64": "bin/darwin-arm64/gemini",
        "darwin-x64": "bin/darwin-x64/gemini",
        "windows-x64": "bin/windows-x64/gemini.exe",
        "windows-arm64": "bin/windows-arm64/gemini.exe",
        "linux-x64": "bin/linux-x64/gemini",
        "linux-arm64": "bin/linux-arm64/gemini"
      }
    },
    {
      "id": "gemini-worker",
      "kind": "worker",
      "path": "dist/worker.js",
      "runtime": "quickjs",
      "criticality": "required",
      "dependsOn": [
        {
          "entryId": "gemini-cli",
          "criticality": "required"
        }
      ]
    }
  ],
  "activationUnits": [
    {
      "id": "gemini-engine",
      "entries": [
        "gemini-cli",
        "gemini-worker"
      ],
      "events": [
        {
          "type": "onEngine",
          "engineId": "gemini"
        }
      ]
    }
  ],
  "contributions": [
    {
      "id": "gemini.engine",
      "type": "mossx.engine.provider",
      "entryId": "gemini-worker",
      "engineId": "gemini"
    }
  ],
  "capabilities": [
    {
      "id": "mossx.engine.provider",
      "role": "provider"
    },
    {
      "id": "mossx.process.spawn",
      "role": "consumer"
    },
    {
      "id": "mossx.workspace.read",
      "role": "consumer"
    }
  ],
  "budgets": {
    "activationDeadlineMs": 10000
  }
}
