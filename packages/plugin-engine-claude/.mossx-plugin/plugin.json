{
  "manifestVersion": 1,
  "pluginId": "com.mossx.engine.claude",
  "version": "1.0.0",
  "displayName": "Claude Engine",
  "description": "Transitional Claude Engine Pilot package. Default-off. Not installed by boot.",
  "publisher": {
    "id": "com.mossx",
    "displayName": "Mossx",
    "homepage": "https://mossx.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mossx/mossx-plugin-engine-claude",
    "commit": "0000000000000000000000000000000000000000"
  },
  "license": "MIT",
  "channel": "stable",
  "compatibility": {
    "coreApi": ">=1.0.0 <2.0.0",
    "platforms": [
      "darwin-arm64",
      "darwin-x64",
      "windows-x64",
      "windows-arm64",
      "linux-x64",
      "linux-arm64"
    ]
  },
  "entries": [
    {
      "id": "claude-cli",
      "kind": "process",
      "criticality": "required",
      "platforms": {
        "darwin-arm64": "bin/darwin-arm64/claude",
        "darwin-x64": "bin/darwin-x64/claude",
        "windows-x64": "bin/windows-x64/claude.exe",
        "windows-arm64": "bin/windows-arm64/claude.exe",
        "linux-x64": "bin/linux-x64/claude",
        "linux-arm64": "bin/linux-arm64/claude"
      }
    },
    {
      "id": "claude-worker",
      "kind": "worker",
      "path": "dist/worker.js",
      "runtime": "quickjs",
      "criticality": "required",
      "dependsOn": [{ "entryId": "claude-cli", "criticality": "required" }]
    }
  ],
  "activationUnits": [
    {
      "id": "claude-engine",
      "entries": ["claude-cli", "claude-worker"],
      "events": [{ "type": "onEngine", "engineId": "claude" }]
    }
  ],
  "contributions": [
    {
      "id": "claude.engine",
      "type": "mossx.engine.provider",
      "entryId": "claude-worker",
      "engineId": "claude"
    }
  ],
  "capabilities": [
    { "id": "mossx.engine.provider", "role": "provider" },
    { "id": "mossx.process.spawn", "role": "consumer" },
    { "id": "mossx.workspace.read", "role": "consumer" }
  ],
  "budgets": { "activationDeadlineMs": 10000 }
}
